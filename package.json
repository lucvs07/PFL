{
  "name": "pfl",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "data:build": "npm run build -w @pfl/data",
    "sim": "tsx packages/sim/src/cli.ts",
    "dev:server": "npm run dev -w @pfl/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
